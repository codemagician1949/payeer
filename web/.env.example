# Network: arc | arc-testnet | local
NEXT_PUBLIC_NETWORK=arc

# Deployed contracts (see contracts/script/Deploy.s.sol)
NEXT_PUBLIC_PAYEER_ADDRESS=0x
NEXT_PUBLIC_PACTS_ADDRESS=0x

# Optional: overrides the canonical USDC address, only needed for local testing
# NEXT_PUBLIC_USDC_ADDRESS=

# Optional: enables WalletConnect / mobile wallets (https://dashboard.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side, for the AI result checker on AI-settled pacts.
# Use a dedicated key that only holds a little USDC for gas: it can propose results, nothing else.
RESOLVER_PRIVATE_KEY=
ANTHROPIC_API_KEY=

# Chat server (run with `pnpm chat`); leave unset to hide chat entirely
NEXT_PUBLIC_CHAT_URL=ws://127.0.0.1:3112
CHAT_PORT=3112

# Result checker for AI-settled pacts. Either:
#   ANTHROPIC_API_KEY=...            (Claude, web search built in — recommended)
#   GROQ_API_KEY=... plus GROQ_SEARCH_MODEL=groq/compound  (needs a tier that allows search)
# GROQ_MODEL powers the in-chat helper on its own.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
